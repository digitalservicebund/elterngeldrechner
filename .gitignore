# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/dist
/index.html

# misc
.DS_Store

# Configuration comes from mise and secrets from fnox, so a dotenv file is
# always a mistake. Ignoring it keeps one that was created anyway from reaching
# a commit.
.env
.env.*

# per-developer overrides of mise.toml and fnox.toml
mise.local.toml
fnox.local.toml

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# direnv
.envrc

# editor settings
.vscode
.history
.idea/

/tmp_preview
public/*.js
public/*.css
public/*.ttf
public/*.woff
public/*.ico
public/*.svg
public/*.html

# locally generated host-page snapshot (see scripts/generate-app-wrapper.sh)
/.app-wrapper/

# The pipeline points mise and npm here, because GitLab can only cache paths
# inside the project directory (see .gitlab-ci.yml).
/.mise/
/.npm/

/sbom.spdx.json

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# idea api file and config
*.http
*.env.json
