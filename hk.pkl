amends "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.53.0/hk@1.53.0#/Builtins.pkl"

// Report every step's findings. Without this a failing linter aborts the run
// before the later steps report, so one error can hide all the others.
fail_fast = false

// Every step calls the script or task that owns the tool's flags, so the
// hook cannot drift from what the pipeline and `mise run check` execute.
local allSteps = new Mapping<String, Step> {
  ["format"] = (Builtins.prettier) {
    check = "npm run --silent format {{files}}"
    check_list_files = "npm run --silent format-list {{files}}"
    fix = "npm run --silent format-fix {{files}}"
  }
  ["stylelint"] = (Builtins.stylelint) {
    glob = "src/**/*.css"
    check = "npm run --silent stylelint {{files}}"
  }
  ["type-check"] = (Builtins.tsc) {
    check = "npm run --silent type-check"
  }
  ["lint"] = (Builtins.ox_lint) {
    check = "npm run --silent lint {{files}}"
    fix = "npm run --silent lint-fix {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stage = false
    fail_on_fix = true
    steps = allSteps
  }

  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }

  ["check"] {
    steps = allSteps
  }
}
