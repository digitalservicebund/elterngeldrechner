{
  "name": "@egr/egr-app",
  "type": "module",
  "files": [
    "dist/*",
    "src/*"
  ],
  "scripts": {
    "start": "scripts/generate-app-wrapper.sh && vite",
    "build:development": "VITE_PREVIEW_BANNER=true vite build --mode development",
    "build:production": "VITE_PREVIEW_BANNER=true vite build --mode production",
    "build:staging": "VITE_PREVIEW_BANNER=true vite build --mode staging",
    "release": "scripts/create-new-tag.sh",
    "test": "LC_ALL=de-DE.utf8 vitest",
    "format": "f() { prettier --ignore-unknown --write ${@:-.}; }; f",
    "test-all": "npm run type-check && npm run lint && npm run stylelint && npm run test",
    "test-smoke": "playwright test --config playwright.smoke.config.ts",
    "type-check": "tsc",
    "lint": "f() { oxlint --no-error-on-unmatched-pattern ${@}; }; f",
    "lint-fix": "f() { oxlint --fix --no-error-on-unmatched-pattern ${@}; }; f",
    "stylelint": "f() { stylelint ${@:-\"src/**/*.css\"}; }; f",
    "posthog:schema:status": "posthog-cli exp schema status",
    "posthog:schema:pull": "posthog-cli exp schema pull",
    "audit-licenses": "license-checker-rseidelsohn --onlyAllow=$(tr '\n' ';' < ./allowed-licenses) --clarificationsFile ./license-clarifications.json --excludePackages='@egr/egr-app@1.1.2' --out /dev/null"
  },
  "engines": {
    "node": "24",
    "npm": "11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.0",
    "@iconify-json/material-symbols": "^1.2.77",
    "@playwright/test": "^1.60.0",
    "@posthog/cli": "^0.7.21",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "commitlint": "^21.0.2",
    "fallow": "^2.91.0",
    "fast-check": "^4.8.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "license-checker-rseidelsohn": "^5.0.1",
    "node-xlsx": "^0.24.0",
    "original-rechner": "github:digitalservicebund/elterngeldrechner-legacy#69ad27a02bb5105e10890338845cf21b727a0c27",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-recommended": "^18.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "@date-fns/utc": "^2.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@posthog/react": "^1.10.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "posthog-js": "^1.382.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.78.0",
    "react-imask": "^7.6.1",
    "react-router": "^7.17.0",
    "zod": "^4.4.3"
  }
}
