{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "outDir": "dist"
  },
  "include": [
    "vite.config.ts",
    "tailwind.config.ts",
    "playwright.config.ts",
    "playwright.smoke.config.ts",
    "commitlint.config.ts",
    "postcss.config.ts",
    "oxlint.config.ts",
    "stylelint.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
